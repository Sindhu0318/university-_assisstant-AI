# ==============================================================================
# UNIASSIST AI - MULTILINGUAL UNIVERSITY RAG PLATFORM CONFIGURATION
# ==============================================================================

# Application & API
APP_NAME="UniAssist AI"
API_V1_STR="/api"
PORT=8000

# Database Configuration
# Local SQLite (zero-config, out-of-the-box):
DATABASE_URL=sqlite:///./university_assistant.db

# Production PostgreSQL + pgvector:
# DATABASE_URL=postgresql://postgres:university_secure_db_password_2026@localhost:5432/university_assistant_db

# Security & JWT Authentication
JWT_SECRET=super-secret-university-jwt-key-2026-secure-random-token
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / LLM & Vector Embeddings
# Options for EMBEDDING_PROVIDER: 'gemini', 'openai', 'hybrid_local'
EMBEDDING_PROVIDER=hybrid_local

# Options for LLM_PROVIDER: 'gemini', 'openai', 'gemini_or_grounded'
LLM_PROVIDER=gemini_or_grounded

# Optional API Keys (Leave blank to use the deterministic zero-hallucination local engine):
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
